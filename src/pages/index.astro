---
import ContentTypeFilter from "@/components/ContentTypeFilter.astro";
import treeLogo from '../../public/tree-logo.svg?raw';
import BaseLayout from '@/layouts/BaseLayout.astro';
import MaturityPostList from '@/components/MaturityPostList.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import { shouldShowPost, sortPostsByDate } from '@/utils/markdown';
const essays = sortPostsByDate((await getCollection('posts')).filter(post => shouldShowPost(post, false)));
const posts = essays;
const seo = { title: siteConfig.homepageTitle, description: siteConfig.description, canonical: siteConfig.site + '/', ogType: 'website' as const };
---
<BaseLayout seoData={seo}>
  <section class="al-garden al-writing-feed" aria-labelledby="writing-title">
    <p class="al-eyebrow">Hi i'm Al. I'm a priest in the Church of England, a software developer and a musician.</p>
    <div class="al-garden-heading"><div class="al-greeting"><span class="al-greeting-logo" aria-hidden="true" set:html={treeLogo} /><h1 id="writing-title">Welcome, friend.</h1></div><a href="/garden/">Explore the garden →</a></div>
    <p class="al-garden-intro">This is my digital garden. A digital garden is like a portfolio but where output is published from the beginning. This means that the collection includes unfinished and bareley started work as well as work that feels complete. The various thoughts and pieces are interconnected allowing you and me to see connecting ideas that, every now and then, result in discovering something new. So there are bits of writing, song ideas and software projects that are potentially embarrasing but I realised that if I wait for content to be ready, I never create anything</p>

    <ContentTypeFilter />
    <MaturityPostList posts={posts} featured context="recent" />
    <a href="/posts/">All posts →</a>
  </section>
</BaseLayout>
<style>
  .al-greeting { display: flex; align-items: center; gap: .8rem; }
  .al-greeting-logo { display: inline-flex; flex: 0 0 auto; }
  .al-greeting-logo :global(svg) { width: clamp(3rem, 6vw, 5rem); height: clamp(3rem, 6vw, 5rem); fill: currentColor; }
  .al-feed-posts { display: grid; gap: 2rem; margin: 2rem 0; }
</style>
