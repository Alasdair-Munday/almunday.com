---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import { shouldShowPost, sortPostsByDate } from '@/utils/markdown';
import { isEssay } from '@/utils/note-maturity.mjs';
const essays = sortPostsByDate((await getCollection('posts')).filter(post => shouldShowPost(post, false) && isEssay(post.data.maturity)));
const posts = essays.slice(0, siteConfig.postOptions.postsPerPage);
const seo = { title: siteConfig.homepageTitle, description: siteConfig.description, canonical: siteConfig.site + '/', ogType: 'website' as const };
---
<BaseLayout seoData={seo}>
  <section class="al-garden al-writing-feed" aria-labelledby="writing-title">
    <p class="al-eyebrow">Rev, dev, musician and overthinker.</p>
    <div class="al-garden-heading"><h1 id="writing-title">Hello, friend.</h1><a href="/garden/">Explore the garden →</a></div>
    <p class="al-garden-intro">Essays and reflections on faith, culture and the things that shape our lives.</p>
    <div class="al-feed-posts">
      {posts.map((post, index) => <PostCard post={post} featured eager={index < 2} context="recent" />)}
    </div>
    <a href="/posts/">All writing →</a>
  </section>
</BaseLayout>
<style>
  .al-feed-posts { display: grid; gap: 2rem; margin: 2rem 0; }
</style>
