---
import { isEssay } from '@/utils/note-maturity.mjs';
import { MATURITY_STAGES, NOTE_MATURITY } from '@/utils/note-maturity.mjs';
import NoteMaturityLegend from '@/components/NoteMaturityLegend.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config';
import { getCollection } from 'astro:content';
import { shouldShowPost } from '@/utils/markdown';
const posts = (await getCollection('posts')).filter(post => shouldShowPost(post, false) && isEssay(post.data.maturity));
const seo = { title: siteConfig.homepageTitle, description: siteConfig.description, canonical: siteConfig.site + '/', ogType: 'website' as const };
---
<BaseLayout seoData={seo}>
  <section class="al-garden" aria-labelledby="garden-title">
    <p class="al-eyebrow">Rev, dev, musician and overthinker.</p>
    <div class="al-garden-heading"><h1 id="garden-title">Hello, friend.</h1><a href="/posts/">Browse as a list →</a></div>
    <p class="al-garden-intro">A garden of reflections, questions and things I’m making. Follow a title to explore.</p>
    <label class="al-maturity-filter" for="garden-minimum-maturity">Minimum maturity
      <select id="garden-minimum-maturity">
        {MATURITY_STAGES.map(stage => <option value={stage} selected={stage === 'growing'}>{NOTE_MATURITY[stage].label}</option>)}
      </select>
    </label>
    <div id="home-graph-container" role="region" aria-label="Interactive graph of published writing"><p class="al-loading">Loading the garden…</p></div>
    <p class="al-graph-help">Drag to explore · Pinch or scroll to zoom · Choose a title to read. Lines follow links between pieces.</p>
    <NoteMaturityLegend />
    <details class="al-list"><summary>Essays</summary><ul>{posts.map(post => <li><a href={`/posts/${post.id}/`}>{post.data.title}</a></li>)}</ul></details>
  </section>
</BaseLayout>

<style>
  .al-maturity-filter { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem; margin: 1rem 0; }
  select { font: inherit; color: inherit; background: transparent; border: 1px solid currentColor; padding: .35rem .6rem; border-radius: .2rem; }
</style>
