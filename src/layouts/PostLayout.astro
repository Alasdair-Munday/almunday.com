---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import NoteMaturity from '@/components/NoteMaturity.astro';
import { connectedReading } from '@/utils/connected-reading.mjs';
import { revisionDate } from '@/utils/post-dates.mjs';
import type { Post, Heading } from '@/types';
import { siteConfig, getCoverAspectClasses } from '@/config';
import { generatePostSEO } from '@/utils/seo';
import { resolveCoverImage } from '@/utils/images';
import { processWikilinksInHTML } from '@/utils/internallinks';
import { getCollection } from 'astro:content';
import { shouldShowPost, processPost, calculateReadingTime, generateTOC, getAdjacentPosts, formatDate, formatDateMobile, getReadingTimeMobile, DATE_LOCALE } from '@/utils/markdown';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import LinkedMentions from '@/components/LinkedMentions.astro';
import LocalGraph from '@/components/LocalGraph.astro';
import GiscusComments from '@/components/GiscusComments.astro';
import Lightbox from '@/components/Lightbox.astro';
import Icon from '@/components/Icon.astro';
import ImageWrapper from '@/components/ImageWrapper.astro';
import { devConfig } from '@/config/dev';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const updated = revisionDate(post.data.date, post.data.lastModified);
let reading: ReturnType<typeof connectedReading> = [];
try {
  const graph = JSON.parse(readFileSync(join(process.cwd(), 'public/graph/graph-data.json'), 'utf8'));
  reading = connectedReading(graph, post.id);
} catch { /* A development session can start before graph data has been generated. */ }

// Check if we're in development mode
const isDev = import.meta.env.DEV;

// Generate SEO data
const seoData = generatePostSEO(post, import.meta.env.SITE || '');

const cover = resolveCoverImage(post.data.image, 'posts', post.id);


// Generate structured data for the post
const structuredData = {
  "@context": "https://schema.schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "author": {
    "@type": "Person",
    "name": siteConfig.author
  },
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.title,
    "logo": {
      "@type": "ImageObject",
      "url": siteConfig.site + "/favicon.ico"
    }
  },
  "datePublished": post.data.date.toISOString(),
  "dateModified": (updated || post.data.date).toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  }
};

// Get all posts for wikilink resolution
const allPosts = await getCollection('posts');
const visiblePosts = allPosts.filter(p => shouldShowPost(p, isDev));

// Process the post content and get processed data including word count
const { Content, headings, wordCount, remarkPluginFrontmatter } = await processPost(post);
const readingTime = calculateReadingTime(post.body || '');

// Generate table of contents if enabled
const hideTOC = post.data.hideTOC === true;
const shouldShowTOC = !hideTOC && siteConfig.tableOfContents.enabled && headings.length > 0;
const toc = shouldShowTOC ? await generateTOC(headings) : [];

// Get adjacent posts for navigation
const { prev: prevPost, next: nextPost } = getAdjacentPosts(visiblePosts, post.id);

// Show the neighbourhood even for an isolated note, without hiding the sidebar.
const showLocalGraph = siteConfig.postOptions.graphView.enabled && siteConfig.postOptions.graphView.showInSidebar;

---

<BaseLayout seoData={seoData}>
  <Fragment slot="head">
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Preload post cover image - only for posts that will definitely show the image immediately -->
    {(() => {
      if (!cover || post.data.hideCoverImage === true) return false;

      const showCoverImages = siteConfig.postOptions.showPostCardCoverImages;
      // Only preload for posts that are likely to show the image immediately
      // Skip preload for complex posts that might have delayed rendering
      const shouldPreload = ['all', 'posts', 'featured-and-posts'].includes(showCoverImages) &&
                           post.id !== 'formatting-reference';

      return shouldPreload;
    })() && (
      <link
        rel="preload"
        as="image"
        href={cover?.url}
        fetchpriority="high"
      />
    )}

    <!-- Post-specific meta tags -->
    {post.data.targetKeyword && (
      <meta name="keywords" content={post.data.targetKeyword}>
    )}
  </Fragment>

  <div class="py-8 relative al-post-shell">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 relative al-post-layout" style={`max-width: ${siteConfig.layout.contentWidth}`}>
      <!-- Main content -->
      <article class={`bg-white dark:bg-primary-900 rounded-lg border border-primary-200 dark:border-primary-700 shadow-xs ${siteConfig.postOptions.showPostCardCoverImages !== 'none' && cover && post.data.hideCoverImage !== true ? 'overflow-hidden' : ''}`}>
        {/* Cover image - shown if global config allows and not hidden by frontmatter */}
        {siteConfig.postOptions.showPostCardCoverImages !== 'none' && cover && post.data.hideCoverImage !== true && (
          <div class={getCoverAspectClasses("rounded-t-lg bg-primary-100 dark:bg-primary-800")}>
            <ImageWrapper
              src={cover.src}
              basePath={cover.basePath}
              alt={post.data.imageAlt || `Featured image for post: ${post.data.title}`}
              class="w-full h-full object-cover"
              width={800}
              height={450}
              format="webp"
              quality={85}
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )}

        <!-- Post content wrapper -->
        <div class={`p-6 ${siteConfig.postOptions.showPostCardCoverImages !== 'none' && cover && post.data.hideCoverImage !== true ? 'rounded-b-lg' : 'rounded-lg'}`}>
          <!-- Post header -->
          <header class="mb-4">
          <h1 class="text-xl font-bold text-primary-900 dark:text-primary-50 mb-6 leading-tight">
            {post.data.title}
          </h1>
          <NoteMaturity maturity={post.data.maturity} />

          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-primary-600 dark:text-primary-300 mb-6">
            <time datetime={post.data.date.toISOString()} class="font-medium">Published{' '}
              <span class="hidden sm:inline">
                {formatDate(post.data.date)}
              </span>
              <span class="sm:hidden">
                {formatDateMobile(post.data.date)}
              </span>
            </time>

            {updated && <time class="al-updated" datetime={updated.toISOString()}>Updated {formatDate(updated)}</time>}

            {siteConfig.postOptions.readingTime && readingTime && (
              <>
                <span class="text-primary-300 dark:text-primary-600 hidden sm:inline">•</span>
                <span class="text-primary-300 dark:text-primary-600 sm:hidden">•</span>
                <span>
                  <span class="hidden sm:inline">{readingTime.text && readingTime.text !== 'read0' && readingTime.text !== '' ? readingTime.text : '1 min read'}</span>
                  <span class="sm:hidden">{getReadingTimeMobile(readingTime)}</span>
                </span>
              </>
            )}

            {siteConfig.postOptions.wordCount && wordCount !== undefined && (
              <>
                <span class="text-primary-300 dark:text-primary-600 hidden sm:inline">•</span>
                <span class="text-primary-300 dark:text-primary-600 sm:hidden">•</span>
                <span class="min-w-0">
                  <span class="hidden sm:inline">{wordCount === 1 ? '1 word' : `${wordCount} words`}</span>
                  <span class="sm:hidden">{wordCount === 1 ? '1 word' : `${wordCount.toLocaleString(DATE_LOCALE)} words`}</span>
                </span>
              </>
            )}
          </div>

          {siteConfig.postOptions.tags && post.data.tags && post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-8">
              {post.data.tags.map(tag => (
                <a
                  href={`/posts/tag/${encodeURIComponent(tag)}`}
                  class="text-xs text-primary-600 dark:text-primary-300 bg-primary-100 dark:bg-primary-800 px-2.5 py-1 rounded-full border border-primary-200 dark:border-primary-700 transition-colors hover:bg-highlight-100 dark:hover:bg-highlight-800"
                >
                  {tag}
                </a>
              ))}
            </div>
          )}
        </header>

        <!-- Article content -->
        <div class="prose dark:prose-dark max-w-none" id="post-content">
          <Content />
        </div>

        {siteConfig.postOptions.linkedMentions.enabled && (
          <LinkedMentions currentSlug={post.id} />
        )}

        <!-- Post navigation -->
        {siteConfig.postOptions.postNavigation && (prevPost || nextPost) && (
          <nav class={`mt-8 pt-8 ${siteConfig.postOptions.linkedMentions.enabled ? '' : 'border-t border-primary-200 dark:border-primary-700'}`}>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {prevPost && (
                <div class="text-left">
                  <a
                    href={`/posts/${prevPost.id}`}
                    class="group block p-4 rounded-lg border border-primary-200 dark:border-primary-700 hover:border-highlight-300 dark:hover:border-highlight-600 transition-all duration-200 hover:shadow-md"
                  >
                    <h3 class="font-semibold text-primary-900 dark:text-primary-50 group-hover:text-highlight-600 dark:group-hover:text-highlight-400 transition-colors">
                      {prevPost.data.title}
                    </h3>
                    <div class="flex justify-start mt-2">
                      <Icon name="arrow-left" class="w-5 h-5 text-primary-500 dark:text-primary-400 group-hover:text-highlight-500 dark:group-hover:text-highlight-400 transition-colors" />
                    </div>
                  </a>
                </div>
              )}

              {nextPost && (
                <div class={`text-right ${!prevPost ? 'md:col-start-2' : ''}`}>
                  <a
                    href={`/posts/${nextPost.id}`}
                    class="group block p-4 rounded-lg border border-primary-200 dark:border-primary-700 hover:border-highlight-300 dark:hover:border-highlight-600 transition-all duration-200 hover:shadow-md"
                  >
                    <h3 class="font-semibold text-primary-900 dark:text-primary-50 group-hover:text-highlight-600 dark:group-hover:text-highlight-400 transition-colors">
                      {nextPost.data.title}
                    </h3>
                    <div class="flex justify-end mt-2">
                      <Icon name="arrow-right" class="w-5 h-5 text-primary-500 dark:text-primary-400 group-hover:text-highlight-500 dark:group-hover:text-highlight-400 transition-colors" />
                    </div>
                  </a>
                </div>
              )}
            </div>
          </nav>
        )}

        <!-- Giscus Comments -->
        {siteConfig.postOptions.comments.enabled && (
          <div class="mt-16">
            <GiscusComments
              postTitle={post.data.title}
              postSlug={post.id}
              postUrl={Astro.url.href}
            />
          </div>
        )}
        </div>
      </article>

      {(showLocalGraph || shouldShowTOC || reading.length > 0) && (
        <aside class="al-post-sidebar" aria-label="Explore this post">
          <div class="al-post-sidebar-inner">
            {showLocalGraph && (
              <section aria-labelledby="connections-title">
                <h2 id="connections-title">Explore connections</h2>
                <p class="al-sidebar-help">Notes and tags up to two steps away. Zoom or expand to read titles.</p>
                <LocalGraph currentSlug={post.id} />
                <a class="al-sidebar-garden-link" href="/garden/">Explore the whole garden →</a>
              </section>
            )}
            {reading.length > 0 && (
              <section class="al-connected-reading" aria-labelledby="connected-reading-title">
                <h2 id="connected-reading-title">Connected reading</h2>
                <ul>{reading.map(note => <li><a href={`/posts/${note.slug}/`}>{note.title}</a><span>{note.reason}</span></li>)}</ul>
              </section>
            )}
            {shouldShowTOC && <TableOfContents headings={toc} />}
          </div>
        </aside>
      )}
    </div>
  </div>

  <Fragment slot="scripts">
    <script define:vars={{ posts: visiblePosts, commentsEnabled: siteConfig.postOptions.comments.enabled, postTitle: post.data.title, postSlug: post.id }}>

      // Process wikilinks - unified logic for all wikilink types
      function initializeWikilinks() {
        const wikilinks = document.querySelectorAll('.wikilink[data-wikilink]');

        wikilinks.forEach(link => {
          const linkText = link.dataset.wikilink;

          // Skip same-page anchors (empty data-wikilink) - they're already properly formatted
          if (!linkText || linkText === '') {
            return;
          }

          const displayOverride = link.dataset.displayOverride;
          const currentDisplayText = link.textContent;

          // Find the matching post - use id (not slug, which is deprecated in Astro v6)
          const slug = linkText.toLowerCase()
            .replace(/[^a-z0-9\s-]/g, '')
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-+|-+$/g, '');

          // Helper function to create slug from title (same as resolveWikilink logic)
          const createSlugFromTitle = (title) => {
            return title.toLowerCase()
              .replace(/[^a-z0-9\s-]/g, '')
              .replace(/\s+/g, '-')
              .replace(/-+/g, '-')
              .replace(/^-+|-+$/g, '');
          };

          // First try exact id match (Astro v6 uses id, not slug)
          let post = posts.find(p => p.id === slug);

          // If not found, try title match (for wikilinks that use post titles)
          if (!post) {
            post = posts.find(p => createSlugFromTitle(p.data.title) === slug);
          }

          if (post) {
            // Update href - preserve anchor if present
            const currentHref = link.href || link.getAttribute('href') || '';
            const anchorMatch = currentHref.match(/#(.+)$/);
            const anchor = anchorMatch ? anchorMatch[1] : null;

            if (anchor) {
              link.href = `/posts/${post.id}#${anchor}`;
            } else {
              link.href = `/posts/${post.id}`;
            }

            // Simple logic:
            // - If displayOverride exists and is not null, it's a wikilink with custom text [[link|display]] - use it
            // - If displayOverride is null/undefined, it's a standard markdown link [text](url) - NEVER change the text
            // - If displayOverride is empty string, it's a naked wikilink [[link]] - use post title

            if (displayOverride && displayOverride !== 'null' && displayOverride !== 'undefined') {
              // Wikilink with custom display: [[link|display]]
              link.textContent = displayOverride;
            } else if (displayOverride === 'null' || displayOverride === null || displayOverride === 'undefined' || displayOverride === undefined) {
              // Standard markdown link: [text](url) - NEVER change the display text
              // Keep currentDisplayText as-is
            } else {
              // Naked wikilink: [[link]] - use post title
              link.textContent = post.data.title;
            }
          } else {
            // Mark as broken link
            link.classList.add('wikilink-broken');
            link.title = 'Link not found';
          }
        });
      }

      // Make function globally available for Swup re-initialization
      window.initializeWikilinks = initializeWikilinks;

      // Process wikilinks and initialize layouts after content loads
      document.addEventListener('DOMContentLoaded', () => {
        // Process external links - handled by BaseLayout, but call here as backup for initial load
        if (window.processExternalLinks) {
          window.processExternalLinks();
        }

        // Initialize wikilinks on initial load
        initializeWikilinks();
      });

      // External links are now handled globally by BaseLayout Swup hooks

    </script>
  </Fragment>

  <!-- Lightbox is handled globally by BaseLayout -->
</BaseLayout>
