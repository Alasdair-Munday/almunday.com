filters:
  and:
    - file.ext == "md"
formulas:
  Slug: |-
    if(file.folder.startsWith("posts"), "/posts/" + file.name.replace(".md", ""),
      if(file.folder.startsWith("projects"), "/projects/" + file.name.replace(".md", ""),
        "/" + file.folder))
  Content Folder: |-
    if(file.name == "index",
      if(file.folder != "",
        if(file.folder.replace("/" + file.folder.replace(/.*\//, ""), "") != "",
          file.folder.replace("/" + file.folder.replace(/.*\//, ""), ""),
          file.folder
        ),
        "root"
      ),
      if(file.folder != "",
        file.folder,
        "root"
      )
    )
properties:
  note.lastModified:
    displayName: Updated
  note.maturity:
    displayName: Maturity
  note.type:
    displayName: Type
  file.fullname:
    displayName: Full File Name
  file.name:
    displayName: File Name
  formula.Slug:
    displayName: Path
  note.date:
    displayName: Date
  note.description:
    displayName: Description
  note.draft:
    displayName: Draft
  note.image:
    displayName: Image
  note.tags:
    displayName: Tags
  note.title:
    displayName: Title
views:
  - type: cms
    name: Blog
    propertyDisplay2: note.maturity
    propertyDisplay3: note.lastModified
    propertyDisplay4: note.type
    filters:
      and:
        - file.folder.startsWith("posts")
    order: []
    sort:
      - property: date
        direction: DESC
    fallbackToEmbeds: never
    propertyDisplay1: note.date
    showTextPreview: true
    imageFormat: cover
    imageProperty: note.image
    showDate: true
    showDraftStatus: true
    draftStatusProperty: note.draft
    propertyLabels: above
    titleProperty: note.title
    propertyLayout12SideBySide: false
    propertyLayout34SideBySide: false
    showTags: true
    tagsProperty: note.tags
    customizeNewButton: true
    newNoteLocation: posts
    cardSize: 250
    imageAspectRatio: 0.55
    maxTagsToShow: 3
    dateIncludeTime: false
    descriptionProperty: note.description
    hideQuickEditIcon: false
  - type: cms
    name: Projects
    filters:
      and:
        - file.folder.startsWith("projects")
    order: []
    sort:
      - property: date
        direction: DESC
    fallbackToEmbeds: never
    propertyDisplay1: note.date
    showTextPreview: true
    imageFormat: none
    showDate: true
    showDraftStatus: false
    propertyLabels: above
    titleProperty: note.title
    showTags: true
    tagsProperty: note.tags
    customizeNewButton: true
    newNoteLocation: projects
    cardSize: 250
    descriptionProperty: note.description
  - type: cms
    name: Vault CMS Guide
    filters:
      and:
        - file.name.endsWith("GUIDE")
    order: []
    sort:
      - property: file.ctime
        direction: DESC
    fallbackToEmbeds: never
    propertyDisplay1: file.fullname
    showTextPreview: true
    imageFormat: none
    showDate: false
    showDraftStatus: false
    propertyLabels: above
    titleProperty: note.title
    showTags: false
    cardSize: 250
    descriptionProperty: note.description
