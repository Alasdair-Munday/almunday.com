---
import { siteConfig } from '../config';
---
<header id="main-header" class="al-header">
  <div class="al-header-inner">
    <a href="/" class="al-brand"><img src="/tree-logo.svg" alt="" width="40" height="40" /><span>{siteConfig.title}</span></a>
    <nav aria-label="Main navigation"><a href="/">Writing</a><a href="/garden/">Garden</a><a href="/about/">About</a></nav>
    <button type="button" id="al-search" aria-label="Search the site">Search <kbd aria-hidden="true">⌘K</kbd></button>
  </div>
</header>
<script>
  function initializeAlHeader() {
    const button = document.getElementById('al-search');
    if (button && !button.dataset.bound) {
      button.dataset.bound = 'true';
      button.addEventListener('click', () => window.dispatchEvent(new CustomEvent('openCommandPalette')));
    }
  }
  initializeAlHeader();
  document.addEventListener('DOMContentLoaded', initializeAlHeader);
  (window as any).initializeAlHeader = initializeAlHeader;
</script>
