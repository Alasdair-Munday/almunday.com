---
import { siteConfig } from '../config/site';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <nav class="footer-links" aria-label="Social and feed links">
      <a href={siteConfig.socialLinks.github} rel="me">GitHub</a>
      <a href={siteConfig.socialLinks.bluesky} rel="me">Bluesky</a>
      <a href={`mailto:${siteConfig.socialLinks.email}`}>Email</a>
      <a href="/rss.xml">RSS</a>
    </nav>
    <p>© {currentYear} Rev Al Munday.</p>
    <p class="colophon">
      Built with <a href="https://github.com/rnt-rez/minrock">Minrock</a> and <a href="https://astro.build">Astro</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding: 2.5rem 0 3rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    text-align: center;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem 1.1rem;
  }

  .footer-links a,
  .colophon a {
    color: var(--text);
    font-weight: 600;
  }

  .footer-links a:hover,
  .colophon a:hover {
    color: var(--accent);
  }

  .site-footer p {
    margin: 0;
  }
</style>
