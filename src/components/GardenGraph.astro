---
import { gardenEntries, noteLinks } from '../utils/garden.mjs';
const entries = gardenEntries();
const height = Math.max(620, Math.ceil(entries.length / 3) * 220 + 100);
const nodes = entries.map((e, i) => ({...e, x: 170 + (i % 3) * 330, y: 125 + Math.floor(i / 3) * 240 + (i % 3 === 1 ? 70 : 0)}));
const edges = nodes.flatMap(e => noteLinks(e, entries).map(href => ({from:e,to:nodes.find(n => n.href===href)!}))).filter((e,i,a)=>a.findIndex(v=>[v.from.href,v.to.href].sort().join('|')===[e.from.href,e.to.href].sort().join('|'))===i);
const wrap = (s:string) => { const lines:string[]=[]; for(const word of s.split(/\s+/)){ if(!lines.length || (lines.at(-1)!.length+word.length)>27) lines.push(word); else lines[lines.length-1]+=' '+word; } return lines; };
---
<section class="garden" aria-label="Explore connected writing">
  <div class="garden-toolbar"><p>Follow a thought.</p><button type="button" data-view aria-expanded="false" aria-controls="garden-list" hidden>Browse as a list</button></div>
  <p class="garden-hint">Choose a title to read. Lines connect pieces that link to one another.</p>
  <div class="graph-shell" data-graph hidden>
    <svg viewBox={`0 0 1000 ${height}`} role="group" aria-label="Map of published writing and projects">
      {edges.map(({from,to})=><line data-from={from.href} data-to={to.href} x1={from.x} y1={from.y} x2={to.x} y2={to.y} />)}
      {nodes.map(n=><a data-node href={n.href} aria-label={n.title}>
        <title>{n.title}</title><circle cx={n.x} cy={n.y} r="5" />
        <text x={n.x} y={n.y+32} text-anchor="middle">{wrap(n.title).map((line,i)=><tspan x={n.x} dy={i===0?0:24}>{line}</tspan>)}</text>
      </a>)}
    </svg>
  </div>
  <div id="garden-list"><ul>{entries.map(e=><li><a href={e.href}>{e.title}</a></li>)}</ul></div>
  {edges.length === 0 && <p class="garden-hint">A garden taking root. Connections will appear as these pieces begin to reference one another.</p>}
</section>
<script>
  function setupGarden(){
    const button=document.querySelector<HTMLButtonElement>('[data-view]');
    const graph=document.querySelector<HTMLElement>('[data-graph]');
    const list=document.getElementById('garden-list');
    if(!button||!graph||!list||button.dataset.ready)return;
    const svg=graph.querySelector('svg')!;
    function layout(){
      const mobile=window.matchMedia('(max-width:600px)').matches;
      const columns=mobile?2:3; const width=mobile?600:1000;
      const positions=new Map<string,{x:number,y:number}>();
      graph!.querySelectorAll<SVGAElement>('[data-node]').forEach((node,i)=>{
        const x=mobile?150+(i%columns)*300:170+(i%columns)*330;
        const y=100+Math.floor(i/columns)*240+(!mobile&&i%columns===1?70:0);
        positions.set(node.getAttribute('href')!,{x,y});
        const circle=node.querySelector('circle')!;circle.setAttribute('cx',String(x));circle.setAttribute('cy',String(y));
        const text=node.querySelector('text')!;text.setAttribute('x',String(x));text.setAttribute('y',String(y+32));
        text.querySelectorAll('tspan').forEach(t=>t.setAttribute('x',String(x)));
      });
      graph!.querySelectorAll('line').forEach(line=>{const a=positions.get(line.dataset.from!)!;const b=positions.get(line.dataset.to!)!;line.setAttribute('x1',String(a.x));line.setAttribute('y1',String(a.y));line.setAttribute('x2',String(b.x));line.setAttribute('y2',String(b.y));});
      svg.setAttribute('viewBox',`0 0 ${width} ${Math.max(420,Math.ceil(positions.size/columns)*240+90)}`);
    }
    layout();window.addEventListener('resize',layout);
    button.dataset.ready='true'; button.hidden=false; graph.hidden=false; list.hidden=true;
    button.addEventListener('click',()=>{ const showList=list.hidden; list.hidden=!showList;graph.hidden=showList;button.textContent=showList?'Browse as a graph':'Browse as a list';button.setAttribute('aria-expanded',String(showList)); });
  }
  setupGarden();document.addEventListener('astro:page-load',setupGarden);
</script>
<style>
.garden{padding:2rem 0}.garden-toolbar{display:flex;align-items:center;justify-content:space-between;gap:1rem}.garden-toolbar p{font-size:1.4rem;margin:0;font-weight:600}.garden-hint{font-size:.9rem;opacity:.8}.garden-toolbar button{font:inherit;font-size:.85rem;background:transparent;color:var(--text);border:1px solid var(--border);border-radius:5px;padding:.4rem .7rem;cursor:pointer}.graph-shell{overflow-x:auto}svg{width:100%;height:auto;display:block}line{stroke:var(--border);stroke-width:1.5}circle{fill:var(--accent)}text{fill:var(--text);font:18px var(--font-sans)}svg a:hover text,svg a:focus text{text-decoration:underline}svg a:focus{outline:none}svg a:focus circle{stroke:var(--text);stroke-width:6}ul{list-style:none;padding:0}li{padding:1rem 0;border-bottom:1px solid var(--border)}[hidden]{display:none!important}@media(max-width:600px){.garden-toolbar{align-items:flex-start}.garden-hint{max-width:30rem}svg text{font-size:22px}}
</style>
