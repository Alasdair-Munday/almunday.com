---
import { gardenEntries, noteLinks } from '../utils/garden.mjs';
const { href } = Astro.props;
const entries = gardenEntries();
const backlinks = entries.filter(e => noteLinks(e, entries).includes(href));
---
{backlinks.length > 0 && <section class="linked-notes" aria-labelledby="linked-heading">
  <h2 id="linked-heading">Linked from</h2>
  <ul>{backlinks.map(e => <li><a href={e.href}>{e.title}</a></li>)}</ul>
</section>}
<style>.linked-notes{margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--border)}h2{font-size:1.1rem}ul{padding-left:1.2rem}</style>
